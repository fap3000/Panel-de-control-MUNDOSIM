# Copiar a .env.local y completar con los valores reales (ese archivo no se commitea)

# En local: ruta al JSON del service account de Google (Sheets API + Drive API,
# ambas solo lectura — Drive hace falta para leer hojas que siguen siendo un
# Excel subido, no convertido a Sheets nativo, ver app/services/sheets.py).
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# En producción (Render): pegar el CONTENIDO completo del JSON acá en vez de usar
# un archivo. Si está seteado, tiene prioridad sobre GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Credenciales de Trello (Power-Up "API Key" + token generado con scope read)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=13mAq7FN

# IDs de las planillas (no son secretos, pero se configuran por env por si cambian)
SHEET_CONSOLIDADO_ID=1OnR7GPTcbMyX_9QlZBGf88PXCbJAx9a1R3hHsWvyaYQ
# PAGOS PROVEEDORES.xlsx: es un Excel real en Drive, no una Sheet nativa — se lee
# vía Drive API + openpyxl (ver _fetch_fresh_values en sheets.py), no vía gspread.
SHEET_PAGOS_PROVEEDORES_ID=1DfNY3u0UAjsDTqVSQQb61rgBfRMGKQIH

# Orígenes permitidos para CORS, separados por coma (URL del frontend)
CORS_ORIGINS=http://localhost:5173

# Proyecto Supabase del Tablero (Project Settings → API en supabase.com) — cache
# persistente de las hojas de Sheets, ver app/services/supabase_cache.py
SUPABASE_URL=
SUPABASE_ANON_KEY=
